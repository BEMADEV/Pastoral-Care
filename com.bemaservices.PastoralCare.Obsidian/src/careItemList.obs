<template>
    <div v-if="careTypes.length" class="mb-3">
        <ul class="nav nav-pills">
            <li v-for="careType in careTypes"
                :key="careType.id"
                :class="{ active: selectedCareTypeId === careType.id }">
                <a href="#" @click.prevent="onSelectCareType(careType.id)">
                    {{ careType.name }}
                </a>
            </li>
        </ul>
    </div>

    <NotificationBox v-else alertType="info">
        There are no current care types.
    </NotificationBox>

    <Grid :definition="gridDefinition"
          :data="gridData"
          keyField="idKey"
          itemTerm="Care Item"
          stickyHeader
          :onAddItem="selectedCareTypeId ? onAddItem : undefined"
          @selectItem="onSelectItem">
        <TextColumn name="requestDate" title="Request Date" field="requestDate" />
        <TextColumn name="personName" title="Name" field="personName" />
        <TextColumn name="requesterName" title="Requester" field="requesterName" />
        <TextColumn name="lastContactDate" title="Last Contact Date" field="lastContactDate" />
        <TextColumn name="lastContactor" title="Last Contactor" field="lastContactor" />
        <TextColumn name="lastContact" title="Last Contact" field="lastContact" />
    </Grid>
</template>

<script setup lang="ts">
import { computed, ref } from "vue";
import { onConfigurationValuesChanged, useConfigurationValues, useInvokeBlockAction, useReloadBlock } from "@Obsidian/Utility/block";
import Grid, { TextColumn } from "@Obsidian/Controls/grid";
import NotificationBox from "@Obsidian/Controls/notificationBox.obs";

type CareTypeSummary = {
    id: number;
    idKey: string;
    name: string;
    isActive: boolean;
    canEdit: boolean;
};

type CareItemRow = {
    id: number;
    idKey: string;
    careTypeId: number;
    requestDate?: string;
    personName?: string;
    requesterName?: string;
    isActive: boolean;
    lastContactDate?: string;
    lastContactor?: string;
    lastContact?: string;
};

type BlockConfig = {
    options?: {
        careTypes?: CareTypeSummary[];
        defaultCareTypeId?: number;
        defaultStatus?: string;
        personId?: number;
    };
    navigationUrls?: Record<string, string>;
};

const config = useConfigurationValues<BlockConfig>();
const invokeBlockAction = useInvokeBlockAction();

onConfigurationValuesChanged(useReloadBlock());

const careTypes = ref<CareTypeSummary[]>(config.options?.careTypes ?? []);
const selectedCareTypeId = ref<number | null>(config.options?.defaultCareTypeId ?? null);
const gridRows = ref<CareItemRow[]>([]);

const gridDefinition = computed(() => ({
    columns: []
}));

const gridData = computed(() => ({
    rows: gridRows.value as unknown as Record<string, unknown>[]
}));

async function loadRows(): Promise<void> {
    if (!selectedCareTypeId.value) {
        gridRows.value = [];
        return;
    }

    const result = await invokeBlockAction<CareItemRow[]>("GetGridData", {
        careTypeId: selectedCareTypeId.value,
        personId: null,
        contactorId: null,
        status: config.options?.defaultStatus ?? ""
    });

    if (result.isSuccess && result.data) {
        gridRows.value = result.data;
    }
}

function onSelectCareType(careTypeId: number): void {
    selectedCareTypeId.value = careTypeId;
    void loadRows();
}

function onSelectItem(idKey: string): void {
    const row = gridRows.value.find(r => r.idKey === idKey);
    if (!row) {
        return;
    }

    const detailUrl = config.navigationUrls?.["DetailPage"];
    if (detailUrl) {
        window.location.href = detailUrl
            .replace("((CareItemId))", row.id.toString())
            .replace("((CareTypeId))", row.careTypeId.toString())
            .replace("((PersonId))", (config.options?.personId ?? 0).toString());
    }
}

function onAddItem(): void {
    const detailUrl = config.navigationUrls?.["DetailPage"];
    if (detailUrl && selectedCareTypeId.value) {
        window.location.href = detailUrl
            .replace("((CareItemId))", "0")
            .replace("((CareTypeId))", selectedCareTypeId.value.toString())
            .replace("((PersonId))", (config.options?.personId ?? 0).toString());
    }
}

void loadRows();
</script>
