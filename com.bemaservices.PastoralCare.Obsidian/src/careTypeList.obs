<template>
    <Panel type="block"
           title="Care Types"
           titleIconCssClass="ti ti-heart"
           class="list-as-blocks">
        <template #headerActions>
            <div class="d-flex gap-x-1">
                <RockButton v-if="config.isAddEnabled"
                            :btnType="BtnType.Default"
                            :btnSize="BtnSize.ExtraSmall"
                            isSquare
                            title="Add Care Type"
                            aria-label="Add Care Type"
                            @click="onAddItem">
                    <i class="ti ti-plus"></i>
                </RockButton>
            </div>
        </template>

        <ul v-if="careTypes.length > 0 || config.options?.allowSharedCareItemAttributes || config.options?.allowSharedCareContactAttributes">
            <li v-for="(careType, index) in careTypes" :key="careType.idKey ?? index">
                <a href="#" @click.prevent="onSelectItem(careType.idKey ?? '')">
                    <i class="ti ti-heart"></i>
                    <h3>{{ careType.name }}</h3>
                    <p v-if="careType.description" class="text-muted">{{ careType.description }}</p>
                </a>
            </li>
            <li v-if="config.options?.allowSharedCareItemAttributes">
                <a href="#" @click.prevent="onSharedCareItemAttributesClick">
                    <i class="ti ti-settings"></i>
                    <h3>Shared Care Item Attributes</h3>
                </a>
            </li>
            <li v-if="config.options?.allowSharedCareContactAttributes">
                <a href="#" @click.prevent="onSharedCareContactAttributesClick">
                    <i class="ti ti-settings"></i>
                    <h3>Shared Care Contact Attributes</h3>
                </a>
            </li>
        </ul>

        <NotificationBox v-else-if="isLoading" :alertType="AlertType.Info">
            Loading care types...
        </NotificationBox>
        <NotificationBox v-else-if="errorMessage" :alertType="AlertType.Danger">
            {{ errorMessage }}
        </NotificationBox>
        <NotificationBox v-else :alertType="AlertType.Info">
            There are no care types to display.
        </NotificationBox>
    </Panel>
</template>

<script setup lang="ts">
import { onConfigurationValuesChanged, useConfigurationValues, useInvokeBlockAction, useReloadBlock } from "@Obsidian/Utility/block";
import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
import Panel from "@Obsidian/Controls/panel.obs";
import RockButton from "@Obsidian/Controls/rockButton.obs";
import { AlertType } from "@Obsidian/Enums/Controls/alertType";
import { BtnSize } from "@Obsidian/Enums/Controls/btnSize";
import { BtnType } from "@Obsidian/Enums/Controls/btnType";
import { ListBlockBox } from "@Obsidian/ViewModels/Blocks/listBlockBox";
import { CareTypeListOptionsBag } from "./viewModels";
import { GridDataBag } from "@Obsidian/ViewModels/Core/Grid/gridDataBag";
import { NavigationUrlKey } from "./CareTypeList/types.partial";
import { ref } from "vue";

type CareTypeGridRow = {
    idKey?: string | null;
    name?: string | null;
    description?: string | null;
};

const config = useConfigurationValues<ListBlockBox<CareTypeListOptionsBag>>();
const invokeBlockAction = useInvokeBlockAction();

// All blocks auto reload when changing block settings unless there is an
// explicit reason not to (like using a custom reload function instead),
// in which case you can remove this code.
onConfigurationValuesChanged(useReloadBlock());

// #region Values

const careTypes = ref<CareTypeGridRow[]>([]);
const isLoading = ref(true);
const errorMessage = ref<string>();

// #endregion

// #region Functions

/** Loads the care type rows used by the tile list. */
async function loadCareTypes(): Promise<void> {
    try {
        const result = await invokeBlockAction<GridDataBag>("GetGridData");

        if (result.isSuccess && result.data) {
            careTypes.value = (result.data.rows ?? []) as CareTypeGridRow[];
        }
        else {
            errorMessage.value = result.errorMessage ?? "Unknown error while trying to load care types.";
        }
    }
    catch (error) {
        errorMessage.value = error instanceof Error ? error.message : "Unknown error while trying to load care types.";
    }
    finally {
        isLoading.value = false;
    }
}

// #endregion

// #region Event Handlers

/**
 * Called when a row has been selected by the individual.
 *
 * @param key The key of the row that was selected.
 */
function onSelectItem(key: string): void {
    if (config.navigationUrls?.[NavigationUrlKey.DetailPage]) {
        window.location.href = config.navigationUrls[NavigationUrlKey.DetailPage].replace("((Key))", key);
    }
}

/**
 * Called when the Add button has been clicked by the individual.
 */
function onAddItem(): void {
    if (config.navigationUrls?.[NavigationUrlKey.DetailPage]) {
        window.location.href = config.navigationUrls[NavigationUrlKey.DetailPage].replace("((Key))", "0");
    }
}

function onSharedCareItemAttributesClick(): void {
    const url = config.navigationUrls?.[NavigationUrlKey.SharedCareItemAttributePage];

    if (url) {
        window.location.href = url;
    }
}

function onSharedCareContactAttributesClick(): void {
    const url = config.navigationUrls?.[NavigationUrlKey.SharedCareContactAttributePage];

    if (url) {
        window.location.href = url;
    }
}

// #endregion

void loadCareTypes();
</script>
