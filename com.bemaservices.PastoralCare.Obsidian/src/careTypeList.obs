<template>
    <Grid :definition="config.gridDefinition ?? undefined"
          :data="gridDataSource"
          keyField="idKey"
          itemTerm="Care Type"
          entityTypeGuid="ce1dfe04-9bc1-423b-a63c-983ac28140b5"
          :expectedRowCount="config.expectedRowCount ?? undefined"
          tooltipField="name"
          stickyHeader
          liveUpdates
          :onAddItem="config.isAddEnabled ? onAddItem : undefined"
          @selectItem="onSelectItem">
        <template #gridActions>
            <div class="btn-group pull-left"
                 v-if="config.options?.allowSharedCareItemAttributes || config.options?.allowSharedCareContactAttributes">
                <button v-if="config.options?.allowSharedCareItemAttributes"
                        class="btn btn-default btn-sm"
                        type="button"
                        @click="onSharedCareItemAttributesClick">
                    Shared Care Item Attributes
                </button>
                <button v-if="config.options?.allowSharedCareContactAttributes"
                        class="btn btn-default btn-sm"
                        type="button"
                        @click="onSharedCareContactAttributesClick">
                    Shared Care Contact Attributes
                </button>
            </div>
        </template>

        <SelectColumn />

        <TextColumn name="description"
                    title="Description"
                    field="description"
                    :filter="textValueFilter"
                    visiblePriority="xs" />

        <TextColumn name="name"
                    title="Name"
                    field="name"
                    :filter="textValueFilter"
                    visiblePriority="xs" />

        <AttributeColumns :attributes="config.gridDefinition?.attributeFields ?? []" />
    </Grid>
</template>

<script setup lang="ts">
import { onConfigurationValuesChanged, useConfigurationValues, useInvokeBlockAction, useReloadBlock } from "@Obsidian/Utility/block";
import Grid, { AttributeColumns, TextColumn, textValueFilter, SelectColumn } from "@Obsidian/Controls/grid";
import { ListBlockBox } from "@Obsidian/ViewModels/Blocks/listBlockBox";
import { CareTypeListOptionsBag } from "./viewModels";
import { GridDataBag } from "@Obsidian/ViewModels/Core/Grid/gridDataBag";
import { NavigationUrlKey } from "./CareTypeList/types.partial";
import { reactive, ref } from "vue";

const config = useConfigurationValues<ListBlockBox<CareTypeListOptionsBag>>();
const invokeBlockAction = useInvokeBlockAction();

// All blocks auto reload when changing block settings unless there is an
// explicit reason not to (like using a custom reload function instead),
// in which case you can remove this code.
onConfigurationValuesChanged(useReloadBlock());

// #region Values

const gridDataSource = ref<Promise<GridDataBag>>();
let gridData: GridDataBag | undefined;

// #endregion

// #region Functions

/**
 * Called when the grid is requesting the row data be loaded.
 */
async function loadGridData(): Promise<GridDataBag> {
    const result = await invokeBlockAction<GridDataBag>("GetGridData");

    if (result.isSuccess && result.data) {
        gridData = reactive(result.data);
        return gridData;
    }
    else {
        throw new Error(result.errorMessage ?? "Unknown error while trying to load grid data.");
    }
}

// #endregion

// #region Event Handlers

/**
 * Called when a row has been selected by the individual.
 *
 * @param key The key of the row that was selected.
 */
function onSelectItem(key: string): void {
    if (config.navigationUrls?.[NavigationUrlKey.DetailPage]) {
        window.location.href = config.navigationUrls[NavigationUrlKey.DetailPage].replace("((Key))", key);
    }
}

/**
 * Called when the Add button has been clicked by the individual.
 */
function onAddItem(): void {
    if (config.navigationUrls?.[NavigationUrlKey.DetailPage]) {
        window.location.href = config.navigationUrls[NavigationUrlKey.DetailPage].replace("((Key))", "0");
    }
}

function onSharedCareItemAttributesClick(): void {
    const url = config.navigationUrls?.[NavigationUrlKey.SharedCareItemAttributePage];

    if (url) {
        window.location.href = url;
    }
}

function onSharedCareContactAttributesClick(): void {
    const url = config.navigationUrls?.[NavigationUrlKey.SharedCareContactAttributePage];

    if (url) {
        window.location.href = url;
    }
}

// #endregion

gridDataSource.value = loadGridData();
</script>
